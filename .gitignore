# Allow-list: ignore everything by default, explicitly allow what matters.
*
!.gitignore
!.gitattributes

# Root-level files
!CLAUDE.md
!settings.json

# Custom skills / slash commands
!commands/
!commands/**

# Hook scripts
!hooks/
!hooks/**

# projects/ is intentionally excluded — memory dirs are locked by the running
# Claude Code process and cannot be reliably tracked via git.
